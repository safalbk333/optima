      "compilerOptions": {
        "tsConfigPath": "apps/vendor-service/tsconfig.app.json"
      }
    },
    "auth-service": {
      "type": "application",
      "root": "apps/auth-service",
      "entryFile": "main",
      "sourceRoot": "apps/auth-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/auth-service/tsconfig.app.json"
      }
    },
    "contracts-service": {
      "type": "application",
      "root": "apps/contracts-service",
      "entryFile": "main",
      "sourceRoot": "apps/contracts-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/contracts-service/tsconfig.app.json"
      }
    },
    "shipment-service": {
      "type": "application",
      "root": "apps/shipment-service",
      "entryFile": "main",
      "sourceRoot": "apps/shipment-service/src",
      "compilerOptions": {
        "tsConfigPath": "apps/shipment-service/tsconfig.app.json"
      }
    }
  }
}