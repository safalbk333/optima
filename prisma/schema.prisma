generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================
// PHASE 1: Foundational Tables
// ============================================================

model tbl_tenant_registry {
  pk_chr_tenant_id    String    @id @default(uuid())
  chr_tenant_name     String    @unique
  chr_tenant_code     String    @unique
  chr_email           String    @unique
  chr_phone           String
  bln_is_active       Boolean   @default(true)
  chr_status          String    @default("ACTIVE")
  tim_created         DateTime  @default(now()) @db.Timestamp(3)
  tim_modified        DateTime? @db.Timestamp(3)
  fk_chr_created_id   String?
  fk_chr_modified_id  String?
  chr_document_status String    @default("N") @db.Char(1)

  users tbl_user[]

  @@map("tbl_tenant_registry")
}

model tbl_user {
  pk_chr_user_id      String    @id @default(uuid())
  fk_chr_tenant_id    String
  chr_user_name       String
  chr_user_email      String    @unique
  chr_user_phone      String
  bln_is_active       Boolean   @default(true)
  tim_created         DateTime  @default(now()) @db.Timestamp(3)
  tim_modified        DateTime? @db.Timestamp(3)
  fk_chr_created_id   String?
  fk_chr_modified_id  String?
  chr_document_status String    @default("N") @db.Char(1)

  tenant tbl_tenant_registry @relation(fields: [fk_chr_tenant_id], references: [pk_chr_tenant_id], onDelete: Restrict, onUpdate: Cascade)

  created_by  tbl_user?  @relation("user_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user?  @relation("user_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  users_created  tbl_user[] @relation("user_created_by")
  users_modified tbl_user[] @relation("user_modified_by")

  user_roles_created       tbl_user_role[]                    @relation("user_role_created_by")
  user_roles_modified      tbl_user_role[]                    @relation("user_role_modified_by")
  user_role_mappings       tbl_user_role_mapping[]            @relation("user_role_mapping_user")
  user_role_mappings_created tbl_user_role_mapping[]          @relation("user_role_mapping_created_by")
  user_role_mappings_modified tbl_user_role_mapping[]         @relation("user_role_mapping_modified_by")
  activations              tbl_activations[]                  @relation("activations_user")
  activations_created      tbl_activations[]                  @relation("activations_created_by")
  activations_modified     tbl_activations[]                  @relation("activations_modified_by")
  countries_created        tbl_country[]                      @relation("country_created_by")
  countries_modified       tbl_country[]                      @relation("country_modified_by")
  cities_created           tbl_city[]                         @relation("city_created_by")
  cities_modified          tbl_city[]                         @relation("city_modified_by")
  departments_created      tbl_department[]                   @relation("department_created_by")
  departments_modified     tbl_department[]                   @relation("department_modified_by")
  categories_created       tbl_category[]                     @relation("category_created_by")
  categories_modified      tbl_category[]                     @relation("category_modified_by")
  priorities_created       tbl_priority[]                     @relation("priority_created_by")
  priorities_modified      tbl_priority[]                     @relation("priority_modified_by")
  request_statuses_created tbl_request_status[]               @relation("request_status_created_by")
  request_statuses_modified tbl_request_status[]              @relation("request_status_modified_by")
  request_phases_created   tbl_request_phase[]                @relation("request_phase_created_by")
  request_phases_modified  tbl_request_phase[]                @relation("request_phase_modified_by")
  notification_types_created tbl_notification_type[]          @relation("notification_type_created_by")
  notification_types_modified tbl_notification_type[]         @relation("notification_type_modified_by")
  approval_levels_created  tbl_approval_level[]               @relation("approval_level_created_by")
  approval_levels_modified tbl_approval_level[]               @relation("approval_level_modified_by")
  sla_policies_created     tbl_sla_policy[]                   @relation("sla_policy_created_by")
  sla_policies_modified    tbl_sla_policy[]                   @relation("sla_policy_modified_by")
  vendors_created          tbl_vendor[]                       @relation("vendor_created_by")
  vendors_modified         tbl_vendor[]                       @relation("vendor_modified_by")
  items_created            tbl_item[]                         @relation("item_created_by")
  items_modified           tbl_item[]                         @relation("item_modified_by")
  vendor_items_created     tbl_vendor_items[]                 @relation("vendor_items_created_by")
  vendor_items_modified    tbl_vendor_items[]                 @relation("vendor_items_modified_by")
  purchase_requests        tbl_purchase_request[]             @relation("purchase_request_requested_by")
  purchase_requests_created tbl_purchase_request[]            @relation("purchase_request_created_by")
  purchase_requests_modified tbl_purchase_request[]           @relation("purchase_request_modified_by")
  approvals                tbl_approval[]                     @relation("approval_approver")
  approvals_created        tbl_approval[]                     @relation("approval_created_by")
  approvals_modified       tbl_approval[]                     @relation("approval_modified_by")
  request_histories        tbl_request_history[]              @relation("request_history_changed_by")
  attachment_masters_uploaded tbl_request_attachment_master[] @relation("attachment_master_uploaded_by")
  attachment_masters_created tbl_request_attachment_master[]  @relation("attachment_master_created_by")
  attachment_masters_modified tbl_request_attachment_master[] @relation("attachment_master_modified_by")
  attachments_uploaded     tbl_request_attachments[]          @relation("attachments_uploaded_by")
  attachments_created      tbl_request_attachments[]          @relation("attachments_created_by")
  attachments_modified     tbl_request_attachments[]          @relation("attachments_modified_by")
  pr_item_mappings_created tbl_purchase_request_item_mapping[] @relation("pr_item_mapping_created_by")
  pr_item_mappings_modified tbl_purchase_request_item_mapping[] @relation("pr_item_mapping_modified_by")
  contracts_created        tbl_contract[]                     @relation("contract_created_by")
  contracts_modified       tbl_contract[]                     @relation("contract_modified_by")
  eois_created             tbl_expression_of_interest[]       @relation("eoi_created_by")
  eois_modified            tbl_expression_of_interest[]       @relation("eoi_modified_by")
  rfqs_created             tbl_request_for_quotation[]        @relation("rfq_created_by")
  rfqs_modified            tbl_request_for_quotation[]        @relation("rfq_modified_by")
  quotations_buyer         tbl_quotation[]                    @relation("quotation_buyer")
  quotations_created       tbl_quotation[]                    @relation("quotation_created_by")
  quotations_modified      tbl_quotation[]                    @relation("quotation_modified_by")
  quotation_items_created  tbl_quotation_item[]               @relation("quotation_item_created_by")
  quotation_items_modified tbl_quotation_item[]               @relation("quotation_item_modified_by")
  purchase_orders_created  tbl_purchase_order[]               @relation("purchase_order_created_by")
  purchase_orders_modified tbl_purchase_order[]               @relation("purchase_order_modified_by")
  goods_receipts_created   tbl_goods_receipt[]                @relation("goods_receipt_created_by")
  goods_receipts_modified  tbl_goods_receipt[]                @relation("goods_receipt_modified_by")
  goods_receipt_items_created tbl_goods_receipt_item[]        @relation("goods_receipt_item_created_by")
  goods_receipt_items_modified tbl_goods_receipt_item[]       @relation("goods_receipt_item_modified_by")
  invoices_created         tbl_invoice[]                      @relation("invoice_created_by")
  invoices_modified        tbl_invoice[]                      @relation("invoice_modified_by")
  chat_rooms_created       tbl_chat_room[]                    @relation("chat_room_created_by")
  chat_rooms_modified      tbl_chat_room[]                    @relation("chat_room_modified_by")
  chat_room_members        tbl_chat_room_member[]             @relation("chat_room_member_user")
  chat_messages            tbl_chat_message[]                 @relation("chat_message_sender")
  notifications            tbl_notification[]                 @relation("notification_user")
  notifications_created    tbl_notification[]                 @relation("notification_created_by")
  notifications_modified   tbl_notification[]                 @relation("notification_modified_by")
  rfq_item_mappings_created  tbl_rfq_item_mapping[] @relation("rfq_item_mapping_created_by")
  rfq_item_mappings_modified tbl_rfq_item_mapping[] @relation("rfq_item_mapping_modified_by")

  @@index([fk_chr_tenant_id])
  @@map("tbl_user")
}

model tbl_user_role {
  pk_chr_role_id      String    @id @default(uuid())
  chr_role_name       String    @unique
  chr_role_code       String    @unique
  txt_description     String?
  bln_is_active       Boolean   @default(true)
  tim_created         DateTime  @default(now()) @db.Timestamp(3)
  tim_modified        DateTime? @db.Timestamp(3)
  fk_chr_created_id   String?
  fk_chr_modified_id  String?
  chr_document_status String    @default("N") @db.Char(1)

  created_by  tbl_user? @relation("user_role_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user? @relation("user_role_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  user_role_mappings tbl_user_role_mapping[]

  @@map("tbl_user_role")
}

model tbl_user_role_mapping {
  pk_chr_user_role_mapping_id String    @id @default(uuid())
  fk_chr_user_id              String
  fk_chr_role_id              String
  bln_is_active               Boolean   @default(true)
  tim_created                 DateTime  @default(now()) @db.Timestamp(3)
  tim_modified                DateTime? @db.Timestamp(3)
  fk_chr_created_id           String?
  fk_chr_modified_id          String?
  chr_document_status         String    @default("N") @db.Char(1)

  user        tbl_user      @relation("user_role_mapping_user", fields: [fk_chr_user_id], references: [pk_chr_user_id], onDelete: Cascade, onUpdate: Cascade)
  role        tbl_user_role @relation(fields: [fk_chr_role_id], references: [pk_chr_role_id], onDelete: Restrict, onUpdate: Cascade)
  created_by  tbl_user?     @relation("user_role_mapping_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user?     @relation("user_role_mapping_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  @@unique([fk_chr_user_id, fk_chr_role_id])
  @@index([fk_chr_user_id])
  @@index([fk_chr_role_id])
  @@index([bln_is_active])
  @@map("tbl_user_role_mapping")
}

model tbl_activations {
  pk_chr_activation_token_id String    @id @default(uuid())
  fk_chr_user_id             String
  chr_token_hash             String    @unique
  tim_expires_at             DateTime  @db.Timestamp(3)
  tim_used_at                DateTime? @db.Timestamp(3)
  bln_is_used                Boolean   @default(false)
  tim_created                DateTime  @default(now()) @db.Timestamp(3)
  tim_modified               DateTime? @db.Timestamp(3)
  fk_chr_created_id          String?
  fk_chr_modified_id         String?
  chr_document_status        String    @default("N") @db.Char(1)

  user        tbl_user  @relation("activations_user", fields: [fk_chr_user_id], references: [pk_chr_user_id], onDelete: Cascade, onUpdate: Cascade)
  created_by  tbl_user? @relation("activations_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user? @relation("activations_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fk_chr_user_id])
  @@index([tim_expires_at])
  @@index([bln_is_used])
  @@map("tbl_activations")
}

model tbl_country {
  pk_chr_country_id   String    @id @default(uuid())
  chr_country_name    String    @unique
  chr_country_code    String    @unique
  bln_is_active       Boolean   @default(true)
  tim_created         DateTime  @default(now()) @db.Timestamp(3)
  tim_modified        DateTime? @db.Timestamp(3)
  fk_chr_created_id   String?
  fk_chr_modified_id  String?
  chr_document_status String    @default("N") @db.Char(1)

  created_by  tbl_user? @relation("country_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user? @relation("country_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  cities  tbl_city[]
  vendors tbl_vendor[]

  @@map("tbl_country")
}

model tbl_city {
  pk_chr_city_id      String    @id @default(uuid())
  chr_city_name       String
  fk_chr_country_id   String
  bln_is_active       Boolean   @default(true)
  tim_created         DateTime  @default(now()) @db.Timestamp(3)
  tim_modified        DateTime? @db.Timestamp(3)
  fk_chr_created_id   String?
  fk_chr_modified_id  String?
  chr_document_status String    @default("D") @db.Char(1)

  country     tbl_country @relation(fields: [fk_chr_country_id], references: [pk_chr_country_id], onDelete: Restrict, onUpdate: Cascade)
  created_by  tbl_user?   @relation("city_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user?   @relation("city_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  vendors tbl_vendor[]

  @@index([fk_chr_country_id])
  @@map("tbl_city")
}

// ============================================================
// PHASE 2: Lookup and Master Data Tables
// ============================================================

model tbl_department {
  pk_chr_department_id String    @id @default(uuid())
  chr_department_name  String    @unique
  chr_department_code  String    @unique
  txt_description      String?
  bln_is_active        Boolean   @default(true)
  tim_created          DateTime  @default(now()) @db.Timestamp(3)
  tim_modified         DateTime? @db.Timestamp(3)
  fk_chr_created_id    String?
  fk_chr_modified_id   String?
  chr_document_status  String    @default("D") @db.Char(1)

  created_by  tbl_user? @relation("department_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user? @relation("department_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  purchase_requests tbl_purchase_request[]

  @@map("tbl_department")
}

model tbl_category {
  pk_chr_category_id  String    @id @default(uuid())
  chr_category_name   String
  bln_is_active       Boolean   @default(true)
  chr_document_status String    @default("D") @db.Char(1)
  dt_deleted_at       DateTime? @db.Timestamp(3)
  tim_created         DateTime  @default(now()) @db.Timestamp(3)
  tim_modified        DateTime? @db.Timestamp(3)
  fk_chr_created_id   String?
  fk_chr_modified_id  String?

  created_by  tbl_user? @relation("category_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user? @relation("category_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  items             tbl_item[]
  purchase_requests tbl_purchase_request[]
  quotations        tbl_quotation[]

  @@index([bln_is_active])
  @@map("tbl_category")
}

model tbl_priority {
  pk_chr_priority_id  String    @id @default(uuid())
  chr_priority_name   String    @unique
  chr_priority_code   String    @unique
  txt_description     String?
  int_level           Int
  bln_is_active       Boolean   @default(true)
  tim_created         DateTime  @default(now()) @db.Timestamp(3)
  tim_modified        DateTime? @db.Timestamp(3)
  fk_chr_created_id   String?
  fk_chr_modified_id  String?
  chr_document_status String    @default("N") @db.Char(1)

  created_by  tbl_user? @relation("priority_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user? @relation("priority_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  purchase_requests tbl_purchase_request[]
  sla_policies      tbl_sla_policy[]

  @@map("tbl_priority")
}

model tbl_request_status {
  pk_chr_request_status_id String    @id @default(uuid())
  chr_status_name          String    @unique
  chr_status_code          String    @unique
  txt_description          String?
  int_order                Int
  bln_is_active            Boolean   @default(true)
  tim_created              DateTime  @default(now()) @db.Timestamp(3)
  tim_modified             DateTime? @db.Timestamp(3)
  fk_chr_created_id        String?
  fk_chr_modified_id       String?
  chr_document_status      String    @default("N") @db.Char(1)

  created_by  tbl_user? @relation("request_status_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user? @relation("request_status_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  purchase_requests         tbl_purchase_request[]  @relation("purchase_request_current_status")
  request_histories_from    tbl_request_history[]   @relation("request_history_from_status")
  request_histories_to      tbl_request_history[]   @relation("request_history_to_status")

  @@map("tbl_request_status")
}

model tbl_request_phase {
  pk_chr_request_phase_id String    @id @default(uuid())
  chr_phase_name          String    @unique
  chr_phase_code          String    @unique
  txt_description         String?
  int_order               Int
  bln_is_active           Boolean   @default(true)
  tim_created             DateTime  @default(now()) @db.Timestamp(3)
  tim_modified            DateTime? @db.Timestamp(3)
  fk_chr_created_id       String?
  fk_chr_modified_id      String?
  chr_document_status     String    @default("N") @db.Char(1)

  created_by  tbl_user? @relation("request_phase_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user? @relation("request_phase_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  request_histories_from tbl_request_history[]          @relation("request_history_from_phase")
  request_histories_to   tbl_request_history[]          @relation("request_history_to_phase")
  attachment_masters     tbl_request_attachment_master[]
  attachments            tbl_request_attachments[]

  @@index([int_order])
  @@index([bln_is_active])
  @@map("tbl_request_phase")
}

model tbl_notification_type {
  pk_chr_notification_type_id String    @id @default(uuid())
  chr_type_name               String    @unique
  chr_type_code               String    @unique
  txt_description             String?
  bln_is_active               Boolean   @default(true)
  tim_created                 DateTime  @default(now()) @db.Timestamp(3)
  tim_modified                DateTime? @db.Timestamp(3)
  fk_chr_created_id           String?
  fk_chr_modified_id          String?
  chr_document_status         String    @default("N") @db.Char(1)

  created_by  tbl_user? @relation("notification_type_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user? @relation("notification_type_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  notifications tbl_notification[]

  @@index([bln_is_active])
  @@map("tbl_notification_type")
}

model tbl_approval_level {
  pk_chr_approval_level_id String    @id @default(uuid())
  chr_approval_level       String    @unique
  txt_description          String?
  int_order                Int
  bln_is_active            Boolean   @default(true)
  flt_from_amount          Float
  flt_to_amount            Float
  tim_created              DateTime  @default(now()) @db.Timestamp(3)
  tim_modified             DateTime? @db.Timestamp(3)
  fk_chr_created_id        String?
  fk_chr_modified_id       String?
  chr_document_status      String    @default("N") @db.Char(1)

  created_by  tbl_user? @relation("approval_level_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user? @relation("approval_level_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  approvals tbl_approval[]

  @@index([bln_is_active])
  @@map("tbl_approval_level")
}

model tbl_sla_policy {
  pk_chr_sla_policy_id      String    @id @default(uuid())
  chr_policy_name           String    @unique
  chr_policy_code           String    @unique
  txt_description           String?
  fk_chr_priority_id        String
  int_response_time_mins    Int
  int_resolution_time_mins  Int
  int_escalation_time_mins  Int
  bln_is_active             Boolean   @default(true)
  tim_created               DateTime  @default(now()) @db.Timestamp(3)
  tim_modified              DateTime? @db.Timestamp(3)
  fk_chr_created_id         String?
  fk_chr_modified_id        String?
  chr_document_status       String    @default("N") @db.Char(1)

  priority    tbl_priority @relation(fields: [fk_chr_priority_id], references: [pk_chr_priority_id], onDelete: Restrict, onUpdate: Cascade)
  created_by  tbl_user?    @relation("sla_policy_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user?    @relation("sla_policy_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fk_chr_priority_id])
  @@index([bln_is_active])
  @@map("tbl_sla_policy")
}

// ============================================================
// PHASE 3: Vendor and Item Tables
// ============================================================

model tbl_vendor {
  pk_chr_vendor_id    String    @id @default(uuid())
  chr_vendor_name     String
  chr_vendor_email    String    @unique
  chr_vendor_phone    String
  fk_chr_country_id   String?
  fk_chr_city_id      String?
  tim_created         DateTime  @default(now()) @db.Timestamp(3)
  tim_modified        DateTime? @db.Timestamp(3)
  fk_chr_created_id   String?
  fk_chr_modified_id  String?
  chr_document_status String    @default("D") @db.Char(1)

  country     tbl_country? @relation(fields: [fk_chr_country_id], references: [pk_chr_country_id], onDelete: SetNull, onUpdate: Cascade)
  city        tbl_city?    @relation(fields: [fk_chr_city_id], references: [pk_chr_city_id], onDelete: SetNull, onUpdate: Cascade)
  created_by  tbl_user?    @relation("vendor_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user?    @relation("vendor_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  vendor_items       tbl_vendor_items[]
  contracts          tbl_contract[]
  eois               tbl_expression_of_interest[]
  quotations         tbl_quotation[]
  purchase_orders    tbl_purchase_order[]
  goods_receipts     tbl_goods_receipt[]
  invoices           tbl_invoice[]
  chat_room_members  tbl_chat_room_member[]
  shipments          tbl_shipment[]

  @@map("tbl_vendor")
}

model tbl_item {
  pk_chr_item_id      String    @id @default(uuid())
  chr_item_name       String
  chr_item_code       String    @unique
  txt_description     String?
  fk_chr_category_id  String
  chr_unit            String?
  chr_documents       String?
  tim_created         DateTime  @default(now()) @db.Timestamp(3)
  tim_modified        DateTime? @db.Timestamp(3)
  fk_chr_created_id   String?
