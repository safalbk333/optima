  goods_receipt           tbl_goods_receipt @relation(fields: [fk_goods_receipt_id], references: [pk_goods_receipt_id], onDelete: Cascade)
  item                    tbl_item          @relation(fields: [fk_item_id], references: [pk_item_id])
  modified_by             tbl_user?         @relation("goods_receipt_item_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fk_goods_receipt_id])
  @@index([fk_item_id])
  @@map("tbl_goods_receipt_item")
}

model tbl_invoice {
  pk_invoice_id        String               @id @default(uuid())
  invoice_number       String               @unique
  fk_purchase_order_id String
  fk_goods_receipt_id  String?
  fk_request_id        String
  fk_vendor_id         String
  status               String               @default("PENDING")
  subtotal             Float
  tax_amount           Float                @default(0)
  total_amount         Float
  currency             String               @default("USD")
  invoice_date          DateTime
  due_date              DateTime
  paid_at               DateTime?
  notes                String?
  created              DateTime             @default(now())
  modified             DateTime?
  fk_created_id        String?
  fk_modified_id       String?
  rendered_html        String?
  is_delete            Boolean               @default(false)
  created_by               tbl_user?            @relation("invoice_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  goods_receipt            tbl_goods_receipt?   @relation(fields: [fk_goods_receipt_id], references: [pk_goods_receipt_id])
  modified_by              tbl_user?            @relation("invoice_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  purchase_order           tbl_purchase_order   @relation(fields: [fk_purchase_order_id], references: [pk_purchase_order_id])
  request                  tbl_purchase_request @relation(fields: [fk_request_id], references: [pk_request_id])
  vendor                   tbl_vendor           @relation(fields: [fk_vendor_id], references: [pk_vendor_id])

  @@index([fk_purchase_order_id])
  @@index([fk_goods_receipt_id])
  @@index([fk_request_id])
  @@index([fk_vendor_id])
  @@index([status])
  @@index([due_date])
  @@index([paid_at])
  @@map("tbl_invoice")
}

