  txt_rendered_html        String?
  chr_document_status      String                   @default("D") @db.Char(1)
  created_by               tbl_user?                @relation("goods_receipt_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by              tbl_user?                @relation("goods_receipt_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  purchase_order           tbl_purchase_order       @relation(fields: [fk_chr_purchase_order_id], references: [pk_chr_purchase_order_id])
  goods_receipt_items      tbl_goods_receipt_item[]
  invoices                 tbl_invoice[]
  shipments                tbl_shipment[]

  @@index([fk_chr_purchase_order_id])
  @@index([chr_status])
  @@index([dt_received_at])
  @@map("tbl_goods_receipt")
}

model tbl_goods_receipt_item {
  pk_chr_gri_id           String            @id @default(uuid())
  fk_chr_goods_receipt_id String
  fk_chr_item_id          String
  int_quantity_ordered    Int
  int_quantity_received   Int
  int_quantity_rejected   Int               @default(0)
  chr_unit_of_measure     String?
  txt_rejection_reason    String?
  tim_created             DateTime          @default(now())
  tim_modified            DateTime?
  fk_chr_created_id       String?
  fk_chr_modified_id      String?
  chr_document_status     String            @default("D") @db.Char(1)
  created_by              tbl_user?         @relation("goods_receipt_item_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  goods_receipt           tbl_goods_receipt @relation(fields: [fk_chr_goods_receipt_id], references: [pk_chr_goods_receipt_id], onDelete: Cascade)
  item                    tbl_item          @relation(fields: [fk_chr_item_id], references: [pk_chr_item_id])
  modified_by             tbl_user?         @relation("goods_receipt_item_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fk_chr_goods_receipt_id])
  @@index([fk_chr_item_id])
  @@map("tbl_goods_receipt_item")
}

model tbl_invoice {
  pk_chr_invoice_id        String               @id @default(uuid())
  chr_invoice_number       String               @unique
  fk_chr_purchase_order_id String
  fk_chr_goods_receipt_id  String?
  fk_chr_request_id        String
  fk_chr_vendor_id         String
  chr_status               String               @default("PENDING")
  flt_subtotal             Float
  flt_tax_amount           Float                @default(0)
  flt_total_amount         Float
  chr_currency             String               @default("USD")
  dt_invoice_date          DateTime
  dt_due_date              DateTime
  dt_paid_at               DateTime?
  txt_notes                String?
  tim_created              DateTime             @default(now())
  tim_modified             DateTime?
  fk_chr_created_id        String?
  fk_chr_modified_id       String?
  txt_rendered_html        String?
  chr_document_status      String               @default("D") @db.Char(1)
  created_by               tbl_user?            @relation("invoice_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  goods_receipt            tbl_goods_receipt?   @relation(fields: [fk_chr_goods_receipt_id], references: [pk_chr_goods_receipt_id])
  modified_by              tbl_user?            @relation("invoice_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  purchase_order           tbl_purchase_order   @relation(fields: [fk_chr_purchase_order_id], references: [pk_chr_purchase_order_id])
  request                  tbl_purchase_request @relation(fields: [fk_chr_request_id], references: [pk_chr_request_id])
  vendor                   tbl_vendor           @relation(fields: [fk_chr_vendor_id], references: [pk_chr_vendor_id])

  @@index([fk_chr_purchase_order_id])
  @@index([fk_chr_goods_receipt_id])
  @@index([fk_chr_request_id])
  @@index([fk_chr_vendor_id])
  @@index([chr_status])
  @@index([dt_due_date])
  @@index([dt_paid_at])
  @@map("tbl_invoice")
}

model tbl_chat_room {
  pk_chr_chat_room_id String                 @id @default(uuid())
  fk_chr_request_id   String
  chr_name            String
  bln_is_active       Boolean                @default(true)
  tim_created         DateTime               @default(now())
  tim_modified        DateTime?
  fk_chr_created_id   String?
  fk_chr_modified_id  String?
  chr_document_status String                 @default("D") @db.Char(1)
  messages            tbl_chat_message[]
  created_by          tbl_user?              @relation("chat_room_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by         tbl_user?              @relation("chat_room_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  request             tbl_purchase_request   @relation(fields: [fk_chr_request_id], references: [pk_chr_request_id], onDelete: Cascade)
  members             tbl_chat_room_member[]

  @@index([fk_chr_request_id])
  @@map("tbl_chat_room")
}

model tbl_chat_room_member {
  pk_chr_chat_room_member_id String        @id @default(uuid())
  fk_chr_chat_room_id        String
  fk_chr_user_id             String?
  fk_chr_vendor_id           String?
  chr_role                   String        @default("MEMBER")
  bln_is_active              Boolean       @default(true)
  tim_created                DateTime      @default(now())
  chat_room                  tbl_chat_room @relation(fields: [fk_chr_chat_room_id], references: [pk_chr_chat_room_id], onDelete: Cascade)
  user                       tbl_user?     @relation("chat_room_member_user", fields: [fk_chr_user_id], references: [pk_chr_user_id])
  vendor                     tbl_vendor?   @relation(fields: [fk_chr_vendor_id], references: [pk_chr_vendor_id])

  @@unique([fk_chr_chat_room_id, fk_chr_user_id])
  @@index([fk_chr_chat_room_id])
  @@map("tbl_chat_room_member")
}

model tbl_chat_message {
  pk_chr_chat_message_id String        @id @default(uuid())
  fk_chr_chat_room_id    String
  fk_chr_sender_id       String
  chr_sender_type        String
  txt_content            String
  bln_is_read            Boolean       @default(false)
  chr_attachment_url     String?
  chr_attachment_type    String?
  tim_created            DateTime      @default(now())
  chat_room              tbl_chat_room @relation(fields: [fk_chr_chat_room_id], references: [pk_chr_chat_room_id], onDelete: Cascade)
  sender                 tbl_user      @relation("chat_message_sender", fields: [fk_chr_sender_id], references: [pk_chr_user_id])

  @@index([fk_chr_chat_room_id])
  @@index([fk_chr_sender_id])
  @@index([tim_created])
  @@map("tbl_chat_message")
}

model tbl_notification {
  pk_chr_notification_id      String                @id @default(uuid())
  fk_chr_notification_type_id String
  fk_chr_user_id              String
  fk_chr_request_id           String?
  chr_title                   String
  txt_message                 String
  chr_channel                 String                @default("IN_APP")
  chr_status                  String                @default("PENDING")
  bln_is_read                 Boolean               @default(false)
  tim_sent_at                 DateTime?
  tim_read_at                 DateTime?
  json_metadata               Json?
  tim_created                 DateTime              @default(now())
  tim_modified                DateTime?
  fk_chr_created_id           String?
  fk_chr_modified_id          String?
  chr_document_status         String                @default("D") @db.Char(1)
  created_by                  tbl_user?             @relation("notification_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by                 tbl_user?             @relation("notification_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  notification_type           tbl_notification_type @relation(fields: [fk_chr_notification_type_id], references: [pk_chr_notification_type_id])
  request                     tbl_purchase_request? @relation(fields: [fk_chr_request_id], references: [pk_chr_request_id])
  user                        tbl_user              @relation("notification_user", fields: [fk_chr_user_id], references: [pk_chr_user_id], onDelete: Cascade)

  @@index([fk_chr_user_id])
  @@index([fk_chr_notification_type_id])
  @@index([fk_chr_request_id])
  @@index([chr_channel])
  @@index([chr_status])
  @@index([bln_is_read])
  @@index([tim_sent_at])
  @@index([tim_created])
  @@map("tbl_notification")
}


model tbl_templates {
  pk_chr_template_id  String    @id @default(uuid())
  chr_template_code   String    @unique
  chr_template_name   String
  chr_document_type   String
  txt_html_content    String
  bln_is_active       Boolean   @default(true)
  tim_created         DateTime  @default(now())
  tim_modified        DateTime?
  chr_document_status String    @default("N") @db.Char(1)

  @@index([chr_template_code])
  @@index([chr_document_type])
  @@index([bln_is_active])
  @@map("tbl_templates")
}

model tbl_company {
  pk_chr_company_id   String    @id @default(uuid())
  chr_company_name    String
  chr_company_code    String    @unique
  chr_company_email   String    @unique
  chr_company_phone   String
  chr_company_address String?
  chr_city            String?
  chr_state           String?
  chr_country         String?
  chr_postal_code     String?
  chr_website         String?
  chr_tax_number      String?
  chr_currency        String    @default("USD")
  chr_logo_url        String?
  bln_is_active       Boolean   @default(true)
  tim_created         DateTime  @default(now())
  tim_modified        DateTime?
  chr_document_status String    @default("N") @db.Char(1)

  users    tbl_user[]    @relation("user_company")
  vendors  tbl_vendor[]  @relation("vendor_company")

  @@index([chr_company_code])
  @@index([bln_is_active])
  @@map("tbl_company")
}