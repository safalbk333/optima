// ========================================================================================
// PHASE 6: Purchase Order, Shipment, Shipment Tracking, Goods Receipt, and Invoice Tables
// ========================================================================================

model tbl_purchase_order {
  pk_purchase_order_id String               @id @default(uuid())
  po_title             String
  fk_request_id        String
  po_number            String               @unique
  fk_vendor_id         String
  total_value          Float
  currency             String               @default("USD")
  status               String
  issued_at            DateTime?
  delivery_address     String?
  expected_delivery    DateTime?
  created              DateTime             @default(now())
  modified             DateTime?
  fk_created_id        String?
  fk_modified_id       String?
  is_delete            Boolean               @default(false)
  fk_quotation_id      String
  rendered_html        String?
  goods_receipts           tbl_goods_receipt[]
  invoices                 tbl_invoice[]
  created_by               tbl_user?            @relation("purchase_order_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by              tbl_user?            @relation("purchase_order_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  quotation                tbl_quotation        @relation(fields: [fk_quotation_id], references: [pk_quotation_id])
  request                  tbl_purchase_request @relation(fields: [fk_request_id], references: [pk_request_id], onDelete: Cascade)
  vendor                   tbl_vendor           @relation(fields: [fk_vendor_id], references: [pk_vendor_id])

  @@index([fk_request_id])
  @@index([fk_vendor_id])
  @@map("tbl_purchase_order")
}

model tbl_shipment {
  pk_shipment_id       String    @id @default(uuid())
  fk_po_number         String
  fk_vendor_id         String
  asn_id               String    @unique
  dispatch_date        DateTime
  delivery_date        DateTime
  logistics_provider   String
  fk_tracking_no       String
  quantity             Int
  status               Int
  notes                String?
  documents            String?
  vendor                   tbl_vendor  @relation(fields: [fk_vendor_id], references: [pk_vendor_id], onDelete: Cascade)
  tracking                 tbl_shipment_tracking @relation(fields: [fk_tracking_no], references: [pk_shipment_tracking_id])
  goods_receipts           tbl_goods_receipt[]
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt
}

model tbl_shipment_tracking {
  pk_shipment_tracking_id   String    @id @default(uuid())
  order_id                  String
  courier_person_name       String
  courier_person_phone      String
  shipments                     tbl_shipment[]
  created_at                    DateTime  @default(now())
  updated_at                    DateTime  @updatedAt
}

model tbl_goods_receipt {
  pk_goods_receipt_id  String                   @id @default(uuid())
  grn_code             String                   @unique
  fk_purchase_order_id String
  status               String                   @default("PENDING")
  received_at           DateTime
  delivery_note_no     String?
  notes                String?
  created              DateTime                 @default(now())
  modified             DateTime?
  fk_created_id        String?
  fk_modified_id       String?
  rendered_html        String?
  is_delete            Boolean                   @default(false)
  created_by               tbl_user?                @relation("goods_receipt_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by              tbl_user?                @relation("goods_receipt_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  purchase_order           tbl_purchase_order       @relation(fields: [fk_purchase_order_id], references: [pk_purchase_order_id])
  goods_receipt_items      tbl_goods_receipt_item[]
  invoices                 tbl_invoice[]
  shipments                tbl_shipment[]

  @@index([fk_purchase_order_id])
  @@index([status])
  @@index([received_at])
  @@map("tbl_goods_receipt")
