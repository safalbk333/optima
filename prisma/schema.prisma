  chat_room                  tbl_chat_room @relation(fields: [fk_chat_room_id], references: [pk_chat_room_id], onDelete: Cascade)
  user                       tbl_user?     @relation("chat_room_member_user", fields: [fk_user_id], references: [pk_user_id])
  vendor                     tbl_vendor?   @relation(fields: [fk_vendor_id], references: [pk_vendor_id])

  @@unique([fk_chat_room_id, fk_user_id])
  @@index([fk_chat_room_id])
  @@map("tbl_chat_room_member")
}

model tbl_chat_message {
  pk_chat_message_id String        @id @default(uuid())
  fk_chat_room_id    String
  fk_sender_id       String
  sender_type        String
  content            String
  is_read            Boolean       @default(false)
  attachment_url     String?
  attachment_type    String?
  created            DateTime      @default(now())
  chat_room              tbl_chat_room @relation(fields: [fk_chat_room_id], references: [pk_chat_room_id], onDelete: Cascade)
  sender                 tbl_user      @relation("chat_message_sender", fields: [fk_sender_id], references: [pk_user_id])

  @@index([fk_chat_room_id])
  @@index([fk_sender_id])
  @@index([created])
  @@map("tbl_chat_message")
}

model tbl_notification {
  pk_notification_id      String                @id @default(uuid())
  fk_notification_type_id String
  fk_user_id              String
  fk_request_id           String?
  title                   String
  message                 String
  channel                 String                @default("IN_APP")
  status                  String                @default("PENDING")
  is_read                 Boolean               @default(false)
  sent_at                 DateTime?
  read_at                 DateTime?
  metadata               Json?
  created                 DateTime              @default(now())
  modified                DateTime?
  fk_created_id           String?
  fk_modified_id          String?
  is_delete               Boolean                @default(false)
  created_by                  tbl_user?             @relation("notification_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by                 tbl_user?             @relation("notification_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  notification_type           tbl_notification_type @relation(fields: [fk_notification_type_id], references: [pk_notification_type_id])
  request                     tbl_purchase_request? @relation(fields: [fk_request_id], references: [pk_request_id])
  user                        tbl_user              @relation("notification_user", fields: [fk_user_id], references: [pk_user_id], onDelete: Cascade)

  @@index([fk_user_id])
  @@index([fk_notification_type_id])
  @@index([fk_request_id])
  @@index([channel])
  @@index([status])
  @@index([is_read])
  @@index([sent_at])
  @@index([created])
  @@map("tbl_notification")
}


model tbl_templates {
  pk_template_id  String    @id @default(uuid())
  template_code   String    @unique
  template_name   String
  document_type   String
  html_content    String
  is_active       Boolean   @default(true)
  created         DateTime  @default(now())
  modified        DateTime?
  is_delete       Boolean    @default(false)

  @@index([template_code])
  @@index([document_type])
  @@index([is_active])
  @@map("tbl_templates")
}

model tbl_company {
  pk_company_id   String    @id @default(uuid())
  company_name    String
  company_code    String    @unique
  company_email   String    @unique
  company_phone   String
  company_address String?
  city            String?
  state           String?
  country         String?
  postal_code     String?
  website         String?
  tax_number      String?
  currency        String    @default("USD")
  logo_url        String?
  is_active       Boolean   @default(true)
  created         DateTime  @default(now())
  modified        DateTime?
