  fk_chr_created_id        String?
  fk_chr_modified_id       String?
  chr_document_status      String    @default("D") @db.Char(1)

  request     tbl_purchase_request @relation(fields: [fk_chr_request_id], references: [pk_chr_request_id], onDelete: Cascade, onUpdate: Cascade)
  vendor      tbl_vendor           @relation(fields: [fk_chr_vendor_id], references: [pk_chr_vendor_id], onDelete: Restrict, onUpdate: Cascade)
  created_by  tbl_user?            @relation("purchase_order_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user?            @relation("purchase_order_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  quotation tbl_quotation @relation(fields: [fk_chr_quotation_id], references: [pk_chr_quotation_id], onDelete: Restrict, onUpdate: Cascade)
  goods_receipts tbl_goods_receipt[]
  invoices       tbl_invoice[]

  @@index([fk_chr_request_id])
  @@index([fk_chr_vendor_id])
  @@map("tbl_purchase_order")
}

model tbl_shipment {
  pk_chr_shipment_id       String    @id @default(uuid())
  fk_po_number             String
  fk_chr_vendor_id         String
  chr_asn_id               String    @unique
  dt_dispatch_date         DateTime
  dt_delivery_date         DateTime
  chr_logistics_provider   String
  fk_chr_tracking_no       String
  int_quantity             Int
  int_status               Int
  chr_notes                String?
  chr_documents            String?
  vendor                   tbl_vendor  @relation(fields: [fk_chr_vendor_id], references: [pk_chr_vendor_id], onDelete: Cascade)
  tracking                 tbl_shipment_tracking @relation(fields: [fk_chr_tracking_no], references: [pk_chr_shipment_tracking_id])
  goods_receipts           tbl_goods_receipt[]
  created_at               DateTime @default(now())
  updated_at               DateTime @updatedAt
}

model tbl_shipment_tracking {
  pk_chr_shipment_tracking_id   String    @id @default(uuid())
  chr_order_id                  String
  chr_courier_person_name       String
  chr_courier_person_phone      String
  shipments                     tbl_shipment[]
  created_at                    DateTime  @default(now())
  updated_at                    DateTime  @updatedAt
}

model tbl_goods_receipt {
  pk_chr_goods_receipt_id  String    @id @default(uuid())
  chr_grn_code             String    @unique
  fk_chr_purchase_order_id String
  fk_chr_request_id        String
  fk_chr_vendor_id         String
  chr_status               String    @default("PENDING")
  dt_received_at           DateTime  @db.Timestamp(3)
  chr_delivery_note_no     String?
  txt_notes                String?
  tim_created              DateTime  @default(now()) @db.Timestamp(3)
  tim_modified             DateTime? @db.Timestamp(3)
  fk_chr_created_id        String?
  fk_chr_modified_id       String?
  chr_document_status      String    @default("D") @db.Char(1)

  purchase_order tbl_purchase_order   @relation(fields: [fk_chr_purchase_order_id], references: [pk_chr_purchase_order_id], onDelete: Restrict, onUpdate: Cascade)
  request        tbl_purchase_request @relation(fields: [fk_chr_request_id], references: [pk_chr_request_id], onDelete: Restrict, onUpdate: Cascade)
  vendor         tbl_vendor           @relation(fields: [fk_chr_vendor_id], references: [pk_chr_vendor_id], onDelete: Restrict, onUpdate: Cascade)
  created_by     tbl_user?            @relation("goods_receipt_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by    tbl_user?            @relation("goods_receipt_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  goods_receipt_items tbl_goods_receipt_item[]
  invoices            tbl_invoice[]
  shipments           tbl_shipment[]

  @@index([fk_chr_purchase_order_id])
  @@index([fk_chr_request_id])
  @@index([fk_chr_vendor_id])
  @@index([chr_status])
  @@index([dt_received_at])
  @@map("tbl_goods_receipt")
}

model tbl_goods_receipt_item {
  pk_chr_gri_id           String    @id @default(uuid())
  fk_chr_goods_receipt_id String
  fk_chr_item_id          String
  int_quantity_ordered    Int
  int_quantity_received   Int
  int_quantity_rejected   Int       @default(0)
  chr_unit_of_measure     String?
  txt_rejection_reason    String?
  tim_created             DateTime  @default(now()) @db.Timestamp(3)
  tim_modified            DateTime? @db.Timestamp(3)
  fk_chr_created_id       String?
  fk_chr_modified_id      String?
  chr_document_status     String    @default("D") @db.Char(1)

  goods_receipt tbl_goods_receipt @relation(fields: [fk_chr_goods_receipt_id], references: [pk_chr_goods_receipt_id], onDelete: Cascade, onUpdate: Cascade)
  item          tbl_item          @relation(fields: [fk_chr_item_id], references: [pk_chr_item_id], onDelete: Restrict, onUpdate: Cascade)
  created_by    tbl_user?         @relation("goods_receipt_item_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by   tbl_user?         @relation("goods_receipt_item_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fk_chr_goods_receipt_id])
  @@index([fk_chr_item_id])
  @@map("tbl_goods_receipt_item")
}

model tbl_invoice {
  pk_chr_invoice_id        String    @id @default(uuid())
  chr_invoice_number       String    @unique
  fk_chr_purchase_order_id String
  fk_chr_goods_receipt_id  String?
  fk_chr_request_id        String
  fk_chr_vendor_id         String
  chr_status               String    @default("PENDING")
  flt_subtotal             Float
  flt_tax_amount           Float     @default(0)
  flt_total_amount         Float
  chr_currency             String    @default("USD")
  dt_invoice_date          DateTime  @db.Timestamp(3)
  dt_due_date              DateTime  @db.Timestamp(3)
  dt_paid_at               DateTime? @db.Timestamp(3)
  txt_notes                String?
  tim_created              DateTime  @default(now()) @db.Timestamp(3)
  tim_modified             DateTime? @db.Timestamp(3)
  fk_chr_created_id        String?
  fk_chr_modified_id       String?
  chr_document_status      String    @default("D") @db.Char(1)

  purchase_order  tbl_purchase_order   @relation(fields: [fk_chr_purchase_order_id], references: [pk_chr_purchase_order_id], onDelete: Restrict, onUpdate: Cascade)
  goods_receipt   tbl_goods_receipt?   @relation(fields: [fk_chr_goods_receipt_id], references: [pk_chr_goods_receipt_id], onDelete: SetNull, onUpdate: Cascade)
  request         tbl_purchase_request @relation(fields: [fk_chr_request_id], references: [pk_chr_request_id], onDelete: Restrict, onUpdate: Cascade)
  vendor          tbl_vendor           @relation(fields: [fk_chr_vendor_id], references: [pk_chr_vendor_id], onDelete: Restrict, onUpdate: Cascade)
  created_by      tbl_user?            @relation("invoice_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by     tbl_user?            @relation("invoice_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fk_chr_purchase_order_id])
  @@index([fk_chr_goods_receipt_id])
  @@index([fk_chr_request_id])
  @@index([fk_chr_vendor_id])
  @@index([chr_status])
  @@index([dt_due_date])
  @@index([dt_paid_at])
  @@map("tbl_invoice")
}

// ============================================================
// PHASE 7: Chat and Notification Tables
// ============================================================

model tbl_chat_room {
  pk_chr_chat_room_id String    @id @default(uuid())
  fk_chr_request_id   String
  chr_name            String
  bln_is_active       Boolean   @default(true)
  tim_created         DateTime  @default(now()) @db.Timestamp(3)
  tim_modified        DateTime? @db.Timestamp(3)
  fk_chr_created_id   String?
  fk_chr_modified_id  String?
  chr_document_status String    @default("D") @db.Char(1)

  request     tbl_purchase_request @relation(fields: [fk_chr_request_id], references: [pk_chr_request_id], onDelete: Cascade, onUpdate: Cascade)
  created_by  tbl_user?            @relation("chat_room_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user?            @relation("chat_room_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  members  tbl_chat_room_member[]
  messages tbl_chat_message[]

  @@index([fk_chr_request_id])
  @@map("tbl_chat_room")
}

model tbl_chat_room_member {
  pk_chr_chat_room_member_id String   @id @default(uuid())
  fk_chr_chat_room_id        String
  fk_chr_user_id             String?
  fk_chr_vendor_id           String?
  chr_role                   String   @default("MEMBER")
  bln_is_active              Boolean  @default(true)
  tim_created                DateTime @default(now()) @db.Timestamp(3)

  chat_room tbl_chat_room @relation(fields: [fk_chr_chat_room_id], references: [pk_chr_chat_room_id], onDelete: Cascade, onUpdate: Cascade)
  user      tbl_user?     @relation("chat_room_member_user", fields: [fk_chr_user_id], references: [pk_chr_user_id], onDelete: SetNull, onUpdate: Cascade)
  vendor    tbl_vendor?   @relation(fields: [fk_chr_vendor_id], references: [pk_chr_vendor_id], onDelete: SetNull, onUpdate: Cascade)

  @@unique([fk_chr_chat_room_id, fk_chr_user_id])
  @@index([fk_chr_chat_room_id])
  @@map("tbl_chat_room_member")
}

model tbl_chat_message {
  pk_chr_chat_message_id String   @id @default(uuid())
  fk_chr_chat_room_id    String
  fk_chr_sender_id       String
  chr_sender_type        String
  txt_content            String
  bln_is_read            Boolean  @default(false)
  chr_attachment_url     String?
  chr_attachment_type    String?
  tim_created            DateTime @default(now()) @db.Timestamp(3)

  chat_room tbl_chat_room @relation(fields: [fk_chr_chat_room_id], references: [pk_chr_chat_room_id], onDelete: Cascade, onUpdate: Cascade)
  sender    tbl_user      @relation("chat_message_sender", fields: [fk_chr_sender_id], references: [pk_chr_user_id], onDelete: Restrict, onUpdate: Cascade)

  @@index([fk_chr_chat_room_id])
  @@index([fk_chr_sender_id])
  @@index([tim_created])
  @@map("tbl_chat_message")
}

model tbl_notification {
  pk_chr_notification_id      String    @id @default(uuid())
  fk_chr_notification_type_id String
  fk_chr_user_id              String
  fk_chr_request_id           String?
  chr_title                   String
  txt_message                 String
  chr_channel                 String    @default("IN_APP")
  chr_status                  String    @default("PENDING")
  bln_is_read                 Boolean   @default(false)
  tim_sent_at                 DateTime? @db.Timestamp(3)
  tim_read_at                 DateTime? @db.Timestamp(3)
  json_metadata               Json?
  tim_created                 DateTime  @default(now()) @db.Timestamp(3)
  tim_modified                DateTime? @db.Timestamp(3)
  fk_chr_created_id           String?
  fk_chr_modified_id          String?
  chr_document_status         String    @default("D") @db.Char(1)

  notification_type tbl_notification_type @relation(fields: [fk_chr_notification_type_id], references: [pk_chr_notification_type_id], onDelete: Restrict, onUpdate: Cascade)
  user              tbl_user              @relation("notification_user", fields: [fk_chr_user_id], references: [pk_chr_user_id], onDelete: Cascade, onUpdate: Cascade)
  request           tbl_purchase_request? @relation(fields: [fk_chr_request_id], references: [pk_chr_request_id], onDelete: SetNull, onUpdate: Cascade)
  created_by        tbl_user?             @relation("notification_created_by", fields: [fk_chr_created_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by       tbl_user?             @relation("notification_modified_by", fields: [fk_chr_modified_id], references: [pk_chr_user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([fk_chr_user_id])
  @@index([fk_chr_notification_type_id])
  @@index([fk_chr_request_id])
  @@index([chr_channel])
  @@index([chr_status])
  @@index([bln_is_read])
  @@index([tim_sent_at])
  @@index([tim_created])
  @@map("tbl_notification")
}

// ============================================================
// USER SERVICE RBAC MODELS
// ============================================================

enum UserSource {
  MANUAL
  AD
}

model User {
  id             String     @id @default(uuid())
  keycloakUserId String     @unique
  optimaId       String     @unique
  email          String     @unique
  firstName      String
  middleName     String?
  lastName       String
  isActive       Boolean    @default(true)
  source         UserSource
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([optimaId])
  @@index([email])
}

model Role {
  id             String   @id @default(uuid())
  keycloakRoleId String   @unique
  name           String   @unique
  description    String?
  createdAt      DateTime @default(now())
}

model PermissionGroup {
  id             String   @id @default(uuid())
  keycloakRoleId String   @unique
  name           String   @unique
  description    String?
  createdAt      DateTime @default(now())
}

model Permission {
  id             String   @id @default(uuid())
  keycloakRoleId String   @unique
  name           String   @unique
  description    String?
  module         String?
  createdAt      DateTime @default(now())
}
