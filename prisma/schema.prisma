  @@index([is_active])
  @@map("tbl_approval_level")
}

model tbl_request_history {
  pk_status_history_id String               @id @default(uuid())
  fk_request_id        String
  fk_from_status       String?
  fk_to_status         String
  fk_from_phase_id     String?
  fk_to_phase_id       String
  fk_changed_by_id     String
