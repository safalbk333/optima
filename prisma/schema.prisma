generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model tbl_user {
  pk_user_id               String                              @id @default(uuid())
  keycloak_id              String
  fk_role_id               String
  user_name                String
  user_email               String                              @unique
  user_phone               String
  is_active                Boolean                             @default(true)
  created                  DateTime                            @default(now())
  modified                 DateTime?
  fk_created_id            String?
  fk_modified_id           String?
  fk_company_id            String?
  is_delete                Boolean                              @default(false) 
  activations_created          tbl_activations[]                   @relation("activations_created_by")
  activations_modified         tbl_activations[]                   @relation("activations_modified_by")
  activations                  tbl_activations[]                   @relation("activations_user")
  approvals                    tbl_approval[]                      @relation("approval_approver")
  approvals_created            tbl_approval[]                      @relation("approval_created_by")
  approvals_modified           tbl_approval[]                      @relation("approval_modified_by")
  approval_levels_created      tbl_approval_level[]                @relation("approval_level_created_by")
  approval_levels_modified     tbl_approval_level[]                @relation("approval_level_modified_by")
  categories_created           tbl_category[]                      @relation("category_created_by")
  categories_modified          tbl_category[]                      @relation("category_modified_by")
  chat_messages                tbl_chat_message[]                  @relation("chat_message_sender")
  chat_rooms_created           tbl_chat_room[]                     @relation("chat_room_created_by")
  chat_rooms_modified          tbl_chat_room[]                     @relation("chat_room_modified_by")
  chat_room_members            tbl_chat_room_member[]              @relation("chat_room_member_user")
  cities_created               tbl_city[]                          @relation("city_created_by")
  cities_modified              tbl_city[]                          @relation("city_modified_by")
  states_created               tbl_state[]                         @relation("state_created_by")
  states_modified              tbl_state[]                         @relation("state_modified_by")
  contracts_created            tbl_contract[]                      @relation("contract_created_by")
  contracts_modified           tbl_contract[]                      @relation("contract_modified_by")
  countries_created            tbl_country[]                       @relation("country_created_by")
  countries_modified           tbl_country[]                       @relation("country_modified_by")
  departments_created          tbl_department[]                    @relation("department_created_by")
  departments_modified         tbl_department[]                    @relation("department_modified_by")
  eois_created                 tbl_expression_of_interest[]        @relation("eoi_created_by")
  eois_modified                tbl_expression_of_interest[]        @relation("eoi_modified_by")
  goods_receipts_created       tbl_goods_receipt[]                 @relation("goods_receipt_created_by")
  goods_receipts_modified      tbl_goods_receipt[]                 @relation("goods_receipt_modified_by")
  goods_receipt_items_created  tbl_goods_receipt_item[]            @relation("goods_receipt_item_created_by")
  goods_receipt_items_modified tbl_goods_receipt_item[]            @relation("goods_receipt_item_modified_by")
  invoices_created             tbl_invoice[]                       @relation("invoice_created_by")
  invoices_modified            tbl_invoice[]                       @relation("invoice_modified_by")
  items_created                tbl_item[]                          @relation("item_created_by")
  items_modified               tbl_item[]                          @relation("item_modified_by")
  notifications_created        tbl_notification[]                  @relation("notification_created_by")
  notifications_modified       tbl_notification[]                  @relation("notification_modified_by")
  notifications                tbl_notification[]                  @relation("notification_user")
  notification_types_created   tbl_notification_type[]             @relation("notification_type_created_by")
  notification_types_modified  tbl_notification_type[]             @relation("notification_type_modified_by")
  purchase_orders_created      tbl_purchase_order[]                @relation("purchase_order_created_by")
  purchase_orders_modified     tbl_purchase_order[]                @relation("purchase_order_modified_by")
  purchase_requests_created    tbl_purchase_request[]              @relation("purchase_request_created_by")
  purchase_requests_modified   tbl_purchase_request[]              @relation("purchase_request_modified_by")
  purchase_requests            tbl_purchase_request[]              @relation("purchase_request_requested_by")
  pr_item_mappings_created     tbl_purchase_request_item_mapping[] @relation("pr_item_mapping_created_by")
  pr_item_mappings_modified    tbl_purchase_request_item_mapping[] @relation("pr_item_mapping_modified_by")
  quotations_buyer             tbl_quotation[]                     @relation("quotation_buyer")
  quotations_created           tbl_quotation[]                     @relation("quotation_created_by")
  quotations_modified          tbl_quotation[]                     @relation("quotation_modified_by")
  attachment_masters_created   tbl_request_attachment_master[]     @relation("attachment_master_created_by")
  attachment_masters_modified  tbl_request_attachment_master[]     @relation("attachment_master_modified_by")
  attachment_masters_uploaded  tbl_request_attachment_master[]     @relation("attachment_master_uploaded_by")
  attachments_created          tbl_request_attachments[]           @relation("attachments_created_by")
  attachments_modified         tbl_request_attachments[]           @relation("attachments_modified_by")
  attachments_uploaded         tbl_request_attachments[]           @relation("attachments_uploaded_by")
  rfqs_created                 tbl_request_for_quotation[]         @relation("rfq_created_by")
  rfqs_modified                tbl_request_for_quotation[]         @relation("rfq_modified_by")
  request_histories            tbl_request_history[]               @relation("request_history_changed_by")
  request_phases_created       tbl_request_phase[]                 @relation("request_phase_created_by")
  request_phases_modified      tbl_request_phase[]                 @relation("request_phase_modified_by")
  sla_policies_created         tbl_sla_policy[]                    @relation("sla_policy_created_by")
  sla_policies_modified        tbl_sla_policy[]                    @relation("sla_policy_modified_by")
  created_by                   tbl_user?                           @relation("user_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  users_created                tbl_user[]                          @relation("user_created_by")
  modified_by                  tbl_user?                           @relation("user_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  users_modified               tbl_user[]                          @relation("user_modified_by")
  roles                        tbl_user_role                       @relation(fields: [fk_role_id], references: [pk_role_id])
  user_roles_created           tbl_user_role[]                     @relation("user_role_created_by")
  user_roles_modified          tbl_user_role[]                     @relation("user_role_modified_by")
  vendor_created               tbl_vendor[]                        @relation("vendor_created_by")
  vendor_modified              tbl_vendor[]                        @relation("vendor_modified_by")
  company                      tbl_company?                        @relation("user_company", fields: [fk_company_id], references: [pk_company_id]) 
  budgets_created              tbl_budget[]                        @relation("budget_created_by")
  budgets_modified             tbl_budget[]                        @relation("budget_modified_by")
  budget_validations           tbl_budget_validation[]             @relation("budget_validator")
  rate_cards_created           tbl_rate_card[]                     @relation("rate_card_created_by")
  rate_cards_modified          tbl_rate_card[]                     @relation("rate_card_modified_by")
  rate_card_items_created      tbl_rate_card_item[]                @relation("rate_card_item_created_by")
  rate_card_items_modified     tbl_rate_card_item[]                @relation("rate_card_item_modified_by")
 
  address_created             tbl_vendor_address[]              @relation("address_created_by")
  address_modified            tbl_vendor_address[]              @relation("address_modified_by")
  tax_created                 tbl_vendor_tax_registrations[]    @relation("tax_created_by")
  tax_modified                tbl_vendor_tax_registrations[]    @relation("tax_modified_by")
  bank_created                tbl_vendor_bank_accounts[]        @relation("bank_created_by")
  bank_modified               tbl_vendor_bank_accounts[]        @relation("bank_modified_by")
  contact_created             tbl_vendor_contact[]              @relation("contact_created_by")
  contact_modified            tbl_vendor_contact[]              @relation("contact_modified_by")
  document_created            tbl_vendor_document[]             @relation("document_created_by")
  document_modified           tbl_vendor_document[]             @relation("document_modified_by")

  @@map("tbl_user")
}

model tbl_user_role {
  pk_role_id          String                  @id @default(uuid())
  role_name           String                  @unique
  role_code           String                  @unique
  description         String?
  is_active           Boolean                 @default(true)
  created             DateTime                @default(now())
  modified            DateTime?
  fk_created_id       String?
  fk_modified_id      String?
  is_delete           Boolean                  @default(false) 
  created_by          tbl_user?                @relation("user_role_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by         tbl_user?                @relation("user_role_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  user                tbl_user[]

  @@map("tbl_user_role")
}

model tbl_activations {
  pk_activation_token_id String    @id @default(uuid())
  fk_user_id             String
  token_hash             String    @unique
  expires_at             DateTime
  used_at                DateTime?
  is_used                Boolean   @default(false)
  created                DateTime  @default(now())
  modified               DateTime?
  fk_created_id          String?
  fk_modified_id         String?
  is_delete              Boolean    @default(false)
  created_by                 tbl_user? @relation("activations_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by                tbl_user? @relation("activations_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  user                       tbl_user  @relation("activations_user", fields: [fk_user_id], references: [pk_user_id], onDelete: Cascade)

  @@index([fk_user_id])
  @@index([expires_at])
  @@index([is_used])
  @@map("tbl_activations")
}

model tbl_country {
  pk_country_id   String       @id @default(uuid())
  country_name    String       @unique
  country_code    String       @unique
  is_active       Boolean      @default(true)
  created         DateTime     @default(now())
  modified        DateTime?
  fk_created_id   String?
  fk_modified_id  String?
  is_delete       Boolean       @default(false)
  cities              tbl_city[]
  states              tbl_state[]
  created_by          tbl_user?    @relation("country_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by         tbl_user?    @relation("country_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)

  bank                tbl_vendor_bank_accounts[]
  tax                 tbl_vendor_tax_registrations[]
  address             tbl_vendor_address[]
  

  @@map("tbl_country")
}

model tbl_state {
  pk_state_id      String       @id @default(uuid())
  state_name       String
  fk_country_id    String
  is_active        Boolean      @default(true)
  created          DateTime     @default(now())
  modified         DateTime?
  fk_created_id    String?
  fk_modified_id   String?
  is_delete        Boolean       @default(false)
  country             tbl_country  @relation(fields: [fk_country_id], references: [pk_country_id])
  created_by          tbl_user?    @relation("state_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by         tbl_user?    @relation("state_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
 
  vendor_addresses    tbl_vendor_address[]
  city                tbl_city[]

  @@index([fk_country_id])
  @@map("tbl_state")
}

model tbl_city {
  pk_city_id      String       @id @default(uuid())
  city_name       String
  fk_country_id   String
  fk_state_id     String
  is_active       Boolean      @default(true)
  created         DateTime     @default(now())
  modified        DateTime?
  fk_created_id   String?
  fk_modified_id  String?
  is_delete       Boolean       @default(false)
  country             tbl_country  @relation(fields: [fk_country_id], references: [pk_country_id])
  state               tbl_state    @relation(fields: [fk_state_id], references: [pk_state_id])
  created_by          tbl_user?    @relation("city_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by         tbl_user?    @relation("city_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)

  address             tbl_vendor_address[]

  @@index([fk_country_id])
  @@map("tbl_city")
}

model tbl_department {
  pk_department_id String                 @id @default(uuid())
  department_name  String                 @unique
  department_code  String                 @unique
  description      String?
  is_active        Boolean                @default(true)
  created          DateTime               @default(now())
  modified         DateTime?
  fk_created_id    String?
  fk_modified_id   String?
  is_delete        Boolean                 @default(false) 
  created_by           tbl_user?              @relation("department_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by          tbl_user?              @relation("department_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  purchase_requests    tbl_purchase_request[]
  budgets tbl_budget[]
  @@map("tbl_department")
}

model tbl_category {
  pk_category_id     String    @id @default(uuid())
  category_name      String

  // Hierarchy
  hierarchy_level    Int
  parent_category_id String?

  parent_category  tbl_category?  @relation("CategoryHierarchy", fields: [parent_category_id], references: [pk_category_id], onDelete: NoAction, onUpdate: NoAction)
  child_categories tbl_category[] @relation("CategoryHierarchy")

  // Audit
  is_active  Boolean   @default(true)
  is_delete  Boolean   @default(false)
  deleted_at DateTime?
  created    DateTime  @default(now())
  modified   DateTime?

  fk_created_id  String?
  fk_modified_id String?

  created_by  tbl_user? @relation("category_created_by",  fields: [fk_created_id],  references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by tbl_user? @relation("category_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)

  // Relations
  items             tbl_item[]
  purchase_requests tbl_purchase_request[]
  quotations        tbl_quotation[]

  @@index([parent_category_id])
  @@index([hierarchy_level])
  @@index([is_active])
  @@map("tbl_category")
}

model tbl_request_phase {
  pk_request_phase_id String                          @id @default(uuid())
  phase_name          String                          @unique
  phase_code          String                          @unique
  description         String?
  order               Int
  is_active           Boolean                         @default(true)
  created             DateTime                        @default(now())
  modified            DateTime?
  fk_created_id       String?
  fk_modified_id      String?
  is_delete           Boolean                          @default(false)
  attachment_masters      tbl_request_attachment_master[]
  attachments             tbl_request_attachments[]
  request_histories_from  tbl_request_history[]           @relation("request_history_from_phase")
  request_histories_to    tbl_request_history[]           @relation("request_history_to_phase")
  created_by              tbl_user?                       @relation("request_phase_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by             tbl_user?                       @relation("request_phase_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([order])
  @@index([is_active])
  @@map("tbl_request_phase")
}

model tbl_notification_type {
  pk_notification_type_id String             @id @default(uuid())
  type_name               String             @unique
  type_code               String             @unique
  description             String?
  is_active               Boolean            @default(true)
  created                 DateTime           @default(now())
  modified                DateTime?
  fk_created_id           String?
  fk_modified_id          String?
  is_delete               Boolean             @default(false)
  notifications               tbl_notification[]
  created_by                  tbl_user?          @relation("notification_type_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by                 tbl_user?          @relation("notification_type_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)

  @@index([is_active])
  @@map("tbl_notification_type")
}

model tbl_sla_policy {
  pk_sla_policy_id     String       @id @default(uuid())
  policy_name          String       @unique
  policy_code          String       @unique
  description          String?
  response_time_mins   Int
  resolution_time_mins Int
  escalation_time_mins Int
  is_active            Boolean      @default(true)
  created              DateTime     @default(now())
  modified             DateTime?
  fk_created_id        String?
  fk_modified_id       String?
  is_delete            Boolean       @default(false)
  created_by               tbl_user?    @relation("sla_policy_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by              tbl_user?    @relation("sla_policy_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)               

  @@index([is_active])
  @@map("tbl_sla_policy")
}



model tbl_vendor {
  pk_vendor_id              String            @id @default(uuid())
  company_legal_name        String
  trading_name              String?
  company_type              String
  registration_number       String
  website                   String?
  business_description      String?
  industry                  String
  number_of_employees       Int?
  year_of_establishment     Int
  msme_status               String
  nature_of_business        String
  categories_of_supply      String
  status                    String  
  notes                     String?          
  created                   DateTime            @default(now())
  modified                  DateTime?
  fk_created_id             String?
  fk_modified_id            String?
  fk_company_id             String?
  is_delete                 Boolean                  @default(false)
  chat_room_members         tbl_chat_room_member[]
  contracts                 tbl_contract[]
  eois                      tbl_expression_of_interest[]
  invoices                  tbl_invoice[]
  purchase_orders           tbl_purchase_order[]
  quotations                tbl_quotation[]
  created_by                tbl_user?                 @relation("vendor_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by               tbl_user?                 @relation("vendor_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  shipments                 tbl_shipment[]
  company                   tbl_company?              @relation("vendor_company", fields: [fk_company_id], references: [pk_company_id])          
  rate_cards                tbl_rate_card[]
  vendor_item_prices        tbl_vendor_item_price[]
  vendor_document           tbl_vendor_document[]
  addresses                 tbl_vendor_address[]
  tax_registrations         tbl_vendor_tax_registrations[]
  bank_accounts             tbl_vendor_bank_accounts[] 
  contacts                  tbl_vendor_contact[]

  @@map("tbl_vendor")
}

model tbl_vendor_contact {
  pk_vendor_contact_id       String      @id @default(uuid())
  fk_vendor_id               String
  first_name                 String
  last_name                  String
  designation                String?
  business_email             String      @unique
  mobile_number              String
  preferred_contact_method   String?
  department                 String?
  alternate_email            String?
  is_primary                 Boolean        @default(false)
  is_delete                  Boolean        @default(false)
  created                    DateTime       @default(now())
  modified                   DateTime?
  fk_created_id              String?
  fk_modified_id             String?
  created_by                 tbl_user?      @relation("contact_created_by",fields: [fk_created_id],references: [pk_user_id],map: "fk_vendor_contact_created_by")
  modified_by                tbl_user?      @relation("contact_modified_by",fields: [fk_modified_id],references: [pk_user_id],map: "fk_vendor_contact_modified_by")
  vendor                     tbl_vendor      @relation(fields: [fk_vendor_id],references: [pk_vendor_id],onDelete: Cascade)

  @@map("tbl_vendor_contact")
}

model tbl_vendor_address {
  pk_vendor_address_id        String            @id @default(uuid())
  fk_vendor_id                String                
  address_type                String
  address_line_1              String
  address_line_2              String?
  fk_city_id                  String
  fk_state_id                 String
  postal_code                 String
  fk_country_id               String         
  created                   DateTime            @default(now())
  modified                  DateTime?
  fk_created_id             String?
  fk_modified_id            String?
  is_delete                 Boolean                  @default(false)
  vendor                    tbl_vendor               @relation(fields: [fk_vendor_id], references: [pk_vendor_id])
  city                      tbl_city?                 @relation(fields: [fk_city_id], references: [pk_city_id])
  state                     tbl_state?                @relation(fields: [fk_state_id], references: [pk_state_id])
  country                   tbl_country?              @relation(fields: [fk_country_id], references: [pk_country_id])
  created_by                tbl_user?                 @relation("address_created_by",fields: [fk_created_id],references: [pk_user_id],map: "fk_vendor_address_created_by")
  modified_by               tbl_user?                 @relation("address_modified_by",fields: [fk_modified_id],references: [pk_user_id],map: "fk_vendor_address_modified_by")

  @@map("tbl_vendor_address")
}

model tbl_vendor_tax_registrations {
  pk_vendor_tax_id          String            @id @default(uuid())
  fk_vendor_id              String                
  fk_country_id             String
  tax_type                  String
  tax_number                String
  registration_name         String
  registration_status       String
  registration_date         DateTime
  expiry_date               DateTime         
  created                   DateTime            @default(now())
  modified                  DateTime?
  fk_created_id             String?
  fk_modified_id            String?
  is_delete                 Boolean                   @default(false)
  vendor                    tbl_vendor                @relation(fields: [fk_vendor_id], references: [pk_vendor_id])
  country                   tbl_country?              @relation(fields: [fk_country_id], references: [pk_country_id])
  created_by                tbl_user?                 @relation("tax_created_by",fields: [fk_created_id],references: [pk_user_id],map: "fk_vendor_tax_created_by")
  modified_by               tbl_user?                 @relation("tax_modified_by",fields: [fk_modified_id],references: [pk_user_id],map: "fk_vendor_tax_modified_by")

  @@map("tbl_vendor_tax_registrations")
}

model tbl_vendor_bank_accounts {
  pk_vendor_bank_account_id String            @id @default(uuid())
  fk_vendor_id              String                
  beneficiary_name          String
  bank_name                 String
  bank_country_id           String
  account_number            String
  account_type              String
  currency                  String
  identifier_type           String       
  identifier_value          String
  branch_name               String
  payment_method            String
  remittance_email          String  
  created                   DateTime            @default(now())
  modified                  DateTime?
  fk_created_id             String?
  fk_modified_id            String?
  is_delete                 Boolean                   @default(false)
  vendor                    tbl_vendor                @relation(fields: [fk_vendor_id], references: [pk_vendor_id])
  country                   tbl_country?              @relation(fields: [bank_country_id], references: [pk_country_id])
  created_by                tbl_user?                 @relation("bank_created_by",fields: [fk_created_id],references: [pk_user_id],map: "fk_vendor_bank_created_by")
  modified_by               tbl_user?                 @relation("bank_modified_by",fields: [fk_modified_id],references: [pk_user_id],map: "fk_vendor_bank_modified_by")

  @@map("tbl_vendor_bank_accounts")
}

model tbl_vendor_document {
  pk_document_id      String   @id @default(uuid())
  fk_vendor_id        String
  document_type       String
  file_name           String
  original_file_name  String
  file_size           Int
  mime_type           String
  file_url            String
  uploaded_at         DateTime    @default(now())
  is_delete           Boolean     @default(false)
  created             DateTime    @default(now())
  modified            DateTime?
  fk_created_id       String?
  fk_modified_id      String?
  created_by          tbl_user?    @relation("document_created_by",fields: [fk_created_id],references: [pk_user_id],map: "fk_vendor_bank_created_by")
  modified_by         tbl_user?    @relation("document_modified_by",fields: [fk_modified_id],references: [pk_user_id],map: "fk_vendor_bank_modified_by")

  vendor          tbl_vendor          @relation(fields: [fk_vendor_id], references: [pk_vendor_id])

  @@map("tbl_vendor_document")
}

model tbl_item {
  pk_item_id          String                              @id @default(uuid())
  item_name           String
