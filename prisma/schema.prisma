model tbl_currency {
  pk_currency_id  String    @id @default(uuid())
  currency_name   String
  currency_code   String    @unique
  symbol          String
  description     String?
  is_active       Boolean   @default(true)
  created         DateTime  @default(now())
  modified        DateTime?
  is_delete       Boolean   @default(false)

  @@index([currency_code])
  @@index([is_active])
  @@map("tbl_currency")
}

model tbl_rate_card {
  pk_rate_card_id     String   @id @default(uuid())

  rate_card_code      String   @unique
  rate_card_name      String

  fk_vendor_id        String

  valid_from          DateTime
  valid_to            DateTime

  status              String   @default("DRAFT")
  remarks             String?

  created             DateTime @default(now())
  modified            DateTime?

  fk_created_id       String?
  fk_modified_id      String?

  is_delete           Boolean  @default(false)

  vendor              tbl_vendor @relation(fields: [fk_vendor_id], references: [pk_vendor_id])

  created_by          tbl_user? @relation("rate_card_created_by", fields: [fk_created_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)
  modified_by         tbl_user? @relation("rate_card_modified_by", fields: [fk_modified_id], references: [pk_user_id], onDelete: NoAction, onUpdate: NoAction)

  items               tbl_rate_card_item[]
  mappings            tbl_vendor_item_price[]

  @@index([fk_vendor_id])
  @@index([status])
  @@index([valid_from])
  @@index([valid_to])

  @@map("tbl_rate_card")
}

model tbl_rate_card_item {
  pk_rate_card_item_id   String @id @default(uuid())

  fk_rate_card_id        String
  fk_item_id             String

  pricing_type           String

  currency               String @default("INR")

  is_active              Boolean @default(true)

  created                DateTime @default(now())
  modified               DateTime?

  fk_created_id          String?
  fk_modified_id         String?

  rate_card              tbl_rate_card @relation(fields: [fk_rate_card_id], references: [pk_rate_card_id], onDelete: Cascade)

  item                   tbl_item @relation(fields: [fk_item_id], references: [pk_item_id])

  created_by             tbl_user? @relation("rate_card_item_created_by", fields: [fk_created_id], references: [pk_user_id])
  modified_by            tbl_user? @relation("rate_card_item_modified_by", fields: [fk_modified_id], references: [pk_user_id])

  fixed_price            tbl_rate_card_fixed_price?
  tiers                  tbl_rate_card_tier[]
  milestones             tbl_rate_card_milestone[]

  mappings               tbl_vendor_item_price[]

  @@unique([fk_rate_card_id, fk_item_id])

  @@index([fk_rate_card_id])
  @@index([fk_item_id])

  @@map("tbl_rate_card_item")
}

model tbl_rate_card_fixed_price {

  pk_fixed_price_id      String @id @default(uuid())

  fk_rate_card_item_id   String @unique

  unit_price             Float

  rate_card_item         tbl_rate_card_item @relation(fields: [fk_rate_card_item_id], references: [pk_rate_card_item_id], onDelete: Cascade)

  @@map("tbl_rate_card_fixed_price")
}

model tbl_rate_card_tier {

  pk_tier_id             String @id @default(uuid())

  fk_rate_card_item_id   String

  min_qty                Int

  max_qty                Int

  unit_price             Float

  rate_card_item         tbl_rate_card_item @relation(fields: [fk_rate_card_item_id], references: [pk_rate_card_item_id], onDelete: Cascade)

  @@index([fk_rate_card_item_id])

  @@map("tbl_rate_card_tier")
}

model tbl_rate_card_milestone {

  pk_milestone_id        String @id @default(uuid())

  fk_rate_card_item_id   String

  milestone_name         String

  milestone_order        Int

  unit_price             Float

  rate_card_item         tbl_rate_card_item @relation(fields: [fk_rate_card_item_id], references: [pk_rate_card_item_id], onDelete: Cascade)

  @@index([fk_rate_card_item_id])

  @@map("tbl_rate_card_milestone")
}

model tbl_vendor_item_price {

  pk_vendor_item_price_id String @id @default(uuid())

  fk_vendor_id            String

  fk_item_id              String

  fk_rate_card_id         String

  fk_rate_card_item_id    String

  is_active               Boolean @default(true)

  vendor                  tbl_vendor @relation(fields: [fk_vendor_id], references: [pk_vendor_id])

  item                    tbl_item @relation(fields: [fk_item_id], references: [pk_item_id])

  rate_card               tbl_rate_card @relation(fields: [fk_rate_card_id], references: [pk_rate_card_id])

  rate_card_item          tbl_rate_card_item @relation(fields: [fk_rate_card_item_id], references: [pk_rate_card_item_id])

  @@unique([fk_vendor_id, fk_item_id, is_active])

  @@index([fk_vendor_id])

  @@index([fk_item_id])

  @@map("tbl_vendor_item_price")
}


model tbl_budget {
  pk_budget_id        String   @id @default(uuid())

  budget_code         String   @unique
  budget_name         String

  fiscal_year         Int

  allocated_amount    Decimal  @db.Decimal(18,2)
  consumed_amount     Decimal  @default(0) @db.Decimal(18,2)
  available_amount    Decimal  @db.Decimal(18,2)

  fk_department_id    String?

  is_active           Boolean  @default(true)

  created             DateTime @default(now())
  modified            DateTime?

  fk_created_id       String?
  fk_modified_id      String?

  created_by          tbl_user? @relation("budget_created_by", fields: [fk_created_id], references: [pk_user_id])
  modified_by         tbl_user? @relation("budget_modified_by", fields: [fk_modified_id], references: [pk_user_id])

  department          tbl_department? @relation(fields: [fk_department_id], references: [pk_department_id])

  validations         tbl_budget_validation[]

  @@index([budget_code])
  @@index([fiscal_year])
  @@map("tbl_budget")
}
model tbl_budget_validation {

  pk_budget_validation_id String @id @default(uuid())

  fk_budget_id         String
  fk_request_id        String
  fk_validated_by      String?

  requested_amount     Decimal @db.Decimal(18,2)
  available_amount     Decimal @db.Decimal(18,2)

  is_override          Boolean @default(false)
  override_reason      String?

  validated_at         DateTime @default(now())

  budget      tbl_budget @relation(fields: [fk_budget_id], references: [pk_budget_id])

  request     tbl_purchase_request @relation(fields: [fk_request_id], references: [pk_request_id])

  validator   tbl_user? @relation("budget_validator",fields: [fk_validated_by],references: [pk_user_id])

  @@index([fk_budget_id])
  @@index([fk_request_id])

  @@map("tbl_budget_validation")
}