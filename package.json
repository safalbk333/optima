{
  "name": "optima-backend",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start:prod": "node dist/apps/optima-backend/main",
    "start:auth": "nest start auth-service",
    "start:auth:dev": "nest start auth-service --watch",
    "start:gateway": "nest start api-gateway",
    "start:gateway:dev": "nest start api-gateway --watch",
    "start:vendor": "nest start vendor-service",
    "start:vendor:dev": "nest start vendor-service --watch",
    "start:master": "nest start master-service",
    "start:master:dev": "nest start master-service --watch",
    "start:request": "nest start request-service",
    "start:request:dev": "nest start request-service --watch",
    "start:shipment": "nest start shipment-service",
    "start:shipment:dev": "nest start shipment-service --watch",
    "start:contracts": "nest start contracts-service",
    "start:contracts:dev": "nest start contracts-service --watch",
    "start:user": "nest start user-service",
    "start:user:dev": "nest start user-service --watch",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage"
  },
  "jest": {
    "moduleFileExtensions": [
      "js",
      "json",
      "ts"
    ],
    "rootDir": ".",
    "testRegex": ".*\\.spec\\.ts$",
    "transform": {
      "^.+\\.(t|j)s$": "ts-jest"
    },
    "moduleNameMapper": {
      "^libs/(.*)$": "<rootDir>/libs/$1"
    },
    "collectCoverageFrom": [
      "**/*.(t|j)s"
    ],
    "coverageDirectory": "../coverage",
    "testEnvironment": "node",
    "start:auth": "nest start auth-service",
    "start:auth:dev": "nest start auth-service --watch",
    "start:contracts": "nest start contracts-service",
    "start:contracts:dev": "nest start contracts-service --watch",
    "start:shipment": "nest start shipment-service",
    "start:shipment:dev": "nest start shipment-service --watch",
    "start:user": "nest start user-service",
    "start:user:dev": "nest start user-service --watch",
    "roots": [
      "<rootDir>/apps/"
    ]
  },
  "dependencies": {
    "@nestjs/common": "^10.0.0",
    "@nestjs/config": "^3.0.0",
    "@nestjs/core": "^10.0.0",
    "@nestjs/microservices": "^10.4.22",
    "@nestjs/platform-express": "^10.0.0",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^7.0.0",
    "@prisma/client": "^6.19.3",
    "axios": "^1.16.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "cron": "^4.4.0",
    "jsonwebtoken": "^9.0.2",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.1.13",
    "rxjs": "^7.8.2",
    "swagger-ui-express": "^5.0.0"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.0.0",
    "@nestjs/schematics": "^10.0.0",
    "@nestjs/testing": "^10.4.22",
    "@types/jest": "^30.0.0",
    "@types/node": "^20.0.0",
    "concurrently": "^9.2.1",
    "jest": "^30.4.2",
    "ts-jest": "^29.4.9",
    "ts-loader": "^9.5.7",
    "ts-node": "^10.9.1",
    "typescript": "^5.0.0",
    "pg": "^8.11.5",
    "@faker-js/faker": "^8.4.1"
  }
}
