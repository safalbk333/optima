{
  "compilerOptions": {
    "module": "commonjs",
    "declaration": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "allowSyntheticDefaultImports": true,
    "target": "ES2021",
    "sourceMap": true,
    "outDir": "./dist",
    "baseUrl": "./",
    "incremental": true,
    "skipLibCheck": true,
    "strict": false,
    "paths": {
      "libs/kafka": ["libs/kafka/index.ts"],
      "libs/kafka/*": ["libs/kafka/*"],
      "libs/database": ["libs/database/index.ts"],
      "libs/database/*": ["libs/database/*"],
      "libs/common/*": ["libs/common/*"]
    }
  }
}